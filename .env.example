# このファイルには変数名と説明だけを書く。ローカルでは .env（git 管理外）に値を書く。
# AWS 上の値は Terraform（infra/app の batch_settings 等）が Lambda の環境変数として設定する。
# 秘密情報（アクセスキー・パスワード）はここにも .env にも書かない。

# ---- ストレージ ----
# local（既定）: ローカルファイル / s3: Amazon S3（Lambda 実行ロール、ローカルでは AWS SDK の既定の資格情報）
STORAGE_MODE=
# local: 画面用データ（index / status / reports）の保存先。既定 ./public/data（next dev が /data/ で配信）
LOCAL_PUBLIC_DIR=
# local: 内部データ（state / locks）の保存先。既定 ./.local/internal（配信されない）
LOCAL_INTERNAL_DIR=
# s3: Web と画面用 JSON のバケット / 画面用 JSON の接頭辞（既定 data/） / 内部データのバケット
PUBLIC_BUCKET=
PUBLIC_PREFIX=
INTERNAL_BUCKET=

# ---- 設定ファイル ----
# 情報源（既定 config/sources.json。サンプルは config/sources.sample.json）
SOURCES_FILE=
# 関心テーマ（既定 config/interests.json）
INTERESTS_FILE=
# file: の情報源を許可（ローカルのサンプルフィード専用。npm run batch:offline が自動で付ける）
ALLOW_FILE_FEEDS=

# ---- 関心度評価 ----
# 読む候補（任意機能）の評価方法。mock（既定）: ルールベース評価（AI 不使用・費用なし） / bedrock: Amazon Bedrock
AI_PROVIDER=
# Bedrock のモデル ID または推論プロファイル ID（候補と確認方法は README「Bedrock モデル」）
#   例: jp.anthropic.claude-haiku-5-5 / amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=
# Bedrock を呼ぶリージョン（既定: AWS_REGION）
BEDROCK_REGION=
AWS_REGION=
# 1 回の AI 呼び出しにまとめる記事数（既定 10）
AI_BATCH_SIZE=
# 1 回の AI 呼び出しの出力トークン上限（既定 2000）
AI_MAX_OUTPUT_TOKENS=
# スロットリング・一時障害時の再試行回数（既定 2） / 1 リクエストのタイムアウト ms（既定 60000）
AI_MAX_RETRIES=
AI_TIMEOUT_MS=
# 1 日あたり AI に渡す記事数の上限（既定 30。再実行を含めた日単位）
MAX_AI_ARTICLES_PER_DAY=
# 1 情報源あたり AI に渡す記事数の上限（既定 10）
MAX_AI_ARTICLES_PER_SOURCE=

# ---- 読む候補 ----
# 最大件数（既定 5。適切な候補がなければ埋めない）
MAX_RECOMMENDATIONS=
# 同じ情報源から入れる最大件数（既定 2）
MAX_RECOMMENDATIONS_PER_SOURCE=
# 読む候補にする関心度スコアの下限 0-100（既定 60）
MIN_RELEVANCE_SCORE=

# ---- 一覧（RSS リーダー） ----
# 一覧に残す日数（既定 30。情報源の retentionDays が優先）
FEED_RETENTION_DAYS=
# 一覧に残す最大件数（既定 2000）
FEED_MAX_ARTICLES=

# ---- 取得 ----
# 読む候補・AI 評価の対象期間（時間、既定 48）。一覧は FEED_RETENTION_DAYS
LOOKBACK_HOURS=
# 公開日時のない記事も読む候補・AI 評価の対象にする（既定 false。一覧には常に載る）
INCLUDE_UNDATED=
# 情報源ごとの最大件数（既定 30）
MAX_ITEMS_PER_SOURCE=
# 取得のタイムアウト ms / 最大バイト数 / 最大リダイレクト回数 / User-Agent
FEED_TIMEOUT_MS=
FEED_MAX_BYTES=
FEED_MAX_REDIRECTS=
FEED_USER_AGENT=

# ---- 実行制御 ----
# バッチ全体の処理時間上限 ms（既定 780000。Lambda では残り実行時間 −90 秒と小さい方）
BATCH_MAX_RUNTIME_MS=
# 既出記事（評価キャッシュ）の保持日数（既定 120）
STATE_RETENTION_DAYS=
# true で当日分を作り直す（ローカル CLI の --force と同じ。Lambda ではイベント {"force": true}）
FORCE=

# ---- ローカル確認（npm run preview） ----
# 設定すると本番と同じ Basic 認証関数を通す。値は npm run auth:hash で作る（ハッシュのみ）
PREVIEW_AUTH_HASH=
