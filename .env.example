# このファイルには変数名と説明だけを書く。実際の値は .env（git 管理外）や
# Azure の Container Apps シークレットに設定する。

# ---- ストレージ（Web・バッチ共通） ----
# local: LOCAL_DATA_DIR のファイルを読む / azure: Blob Storage（Managed Identity）
STORAGE_MODE=
# ローカル保存先（既定 ./data）
LOCAL_DATA_DIR=
# 例: https://<アカウント名>.blob.core.windows.net （アカウントキーは使わない）
AZURE_STORAGE_ACCOUNT_URL=
# Blob コンテナー名（既定 digest）
AZURE_STORAGE_CONTAINER=
# ユーザー割り当て Managed Identity のクライアントID（Azure 上でのみ設定）
AZURE_CLIENT_ID=

# ---- Web ----
# ストレージ読み取りのメモリキャッシュ秒数（既定 60）
WEB_CACHE_TTL_SECONDS=

# ---- バッチ: AI ----
# mock（既定・AI不使用） / claude / azure-openai
AI_PROVIDER=
# 利用するモデル名（claude の場合は利用可能なモデルIDを確認して設定。例は README 参照）
AI_MODEL=
# AI API キー（秘密情報。Git・イメージ・ログに含めない）
AI_API_KEY=
# 出力トークン上限（既定 2048）
AI_MAX_OUTPUT_TOKENS=
# 1記事あたりの入力文字数上限（既定 3000）
AI_MAX_INPUT_CHARS=
# API リトライ回数（既定 2）
AI_MAX_RETRIES=
# 1リクエストのタイムアウト ms（既定 60000）
AI_TIMEOUT_MS=
# claude の effort: low / medium / high（既定 low）
AI_EFFORT=
# claude の拒否時サーバー側フォールバック: default / off（既定 default）
CLAUDE_FALLBACKS=
# azure-openai の場合のみ
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ---- バッチ: 収集・選定 ----
# 1日あたり AI に渡す記事数上限（既定 10。再実行を含めた日単位）
MAX_AI_ARTICLES_PER_DAY=
# 1日あたり掲載上限（既定 5）
MAX_PUBLISHED_ARTICLES=
# 掲載する最低重要度 0-3（既定 2）
MIN_RELEVANCE=
# 取得・選定対象期間（時間、既定 48）
LOOKBACK_HOURS=
# 取得元ごとの最大件数（既定 20）
MAX_ITEMS_PER_SOURCE=
# フィード取得のタイムアウト ms / 最大バイト数
FEED_TIMEOUT_MS=
FEED_MAX_BYTES=
FEED_USER_AGENT=
# バッチ全体の実行時間上限 ms（既定 900000）
BATCH_MAX_RUNTIME_MS=
# 既出記事の保持日数（既定 120）
STATE_RETENTION_DAYS=
# 取得元設定ファイル（既定 config/sources.json）
SOURCES_FILE=
# true で当日分を作り直す（--force と同じ）
FORCE=
