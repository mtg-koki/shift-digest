# syntax=docker/dockerfile:1
# 日次バッチ。依存込みの単一ファイルにバンドルし、実行イメージには node_modules を含めない。
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build:batch

FROM node:24-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/dist/batch/main.mjs ./main.mjs
COPY --chown=node:node config/sources.json ./config/sources.json
USER node
# 終了コード 0=成功/スキップ, 1=失敗
ENTRYPOINT ["node", "main.mjs"]
