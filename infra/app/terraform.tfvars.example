# 手元で plan / apply する場合に terraform.tfvars にコピーして使う（git 管理外）。
# CI では GitHub Variables / Secrets から TF_VAR_* で渡す。
aws_region               = "ap-northeast-1"
name_prefix              = "shift-digest"
permissions_boundary_arn = "arn:aws:iam::123456789012:policy/shift-digest-policy-boundary-01" # bootstrap の出力

# 空ならモック要約（AI 不使用）。Bedrock を使う場合の候補は README「Bedrock モデル」参照
bedrock_model_id = ""
# bedrock_model_id = "jp.anthropic.claude-haiku-5-5"
# bedrock_model_id = "amazon.nova-lite-v1:0"

# 通知先（メールアドレスはリポジトリに書かない。このファイルは git 管理外）
# alert_emails  = ["you@example.com"]
# budget_emails = ["you@example.com"]
# budget_monthly_usd = 5
